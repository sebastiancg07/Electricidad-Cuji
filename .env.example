# Puerto del servidor (Render asigna automáticamente process.env.PORT)
PORT=3000

# Clave secreta que enviará el ESP32 en ?key=
PING_SECRET_KEY=tu_clave_secreta_super_segura_123

# Token del bot creado con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ID de chat o grupo donde se recibirán las alertas (ej: 987654321 o -1001234567890 para grupos)
TELEGRAM_CHAT_ID=-1001234567890

# Período de gracia en segundos antes de disparar la alerta de corte (default: 180 = 3 minutos)
GRACE_PERIOD_SECONDS=180
